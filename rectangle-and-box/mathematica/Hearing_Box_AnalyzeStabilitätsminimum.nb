Cell[BoxData[{
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<C:\\\\Users\\\\sulta\\\\git\\\\cone-operator-lab\\\\data\\\\\
meshes\\\\stability_surface_box_mesh.txt\>\"", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "\"\<# r-values\>\"", "}"}], ",", "rVals", ",", 
      RowBox[{"{", "\"\<# s-values\>\"", "}"}], ",", "sVals", ",", 
      RowBox[{"{", "\"\<# z-matrix (rows=r, cols=s)\>\"", "}"}], ",", 
      "zMat"}], "}"}], ",", "\"\<Table\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<C:\\\\Users\\\\sulta\\\\git\\\\cone-operator-lab\\\\data\\\\\
meshes\\\\stability_surface_box_abcxyz.csv\>\"", ",", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"a", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], "*", "a"}], ",", 
          RowBox[{"(*", 
           RowBox[{"b", "=", 
            RowBox[{"x", "*", "a"}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], "*", "a"}], ",", 
          RowBox[{"(*", 
           RowBox[{"c", "=", 
            RowBox[{"y", "*", "a"}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "      ", 
          RowBox[{"(*", 
           RowBox[{"x", "=", 
            RowBox[{"b", "/", "a"}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "      ", 
          RowBox[{"(*", 
           RowBox[{"y", "=", 
            RowBox[{"c", "/", "a"}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "3"}], "]"}], "]"}]}], "         ", 
         RowBox[{"(*", 
          RowBox[{"z", "=", 
           RowBox[{"f", "*"}]}], "*)"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\"", 
        ",", "\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}], 
     "]"}], ",", "\"\<CSV\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Export", "[", 
    RowBox[{"\"\<C:\\\\Users\\\\sulta\\\\git\\\\cone-operator-lab\\\\data\\\\\
meshes\\\\stability_surface_box_metadata.txt\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<# Stability surface for Dirichlet box Laplacian\>\"", 
       ",", "\"\<# Quantity: f* = t_min * lambda_N (stability minimum of A2 \
reconstruction)\>\"", ",", "\"\<\>\"", ",", "\"\<Geometry:\>\"", 
       ",", "\"\<  Domain: rectangular box\>\"", 
       ",", "\"\<  Boundary conditions: Dirichlet\>\"", 
       ",", "\"\<  Box dimensions:\>\"", 
       ",", "\"\<    a, b, c explicitly stored in data file\>\"", 
       ",", "\"\<  Normalization:\>\"", 
       ",", "\"\<    a fixed to 1.0 in this dataset\>\"", ",", "\"\<\>\"", 
       ",", "\"\<Derived parameters:\>\"", ",", "\"\<  x = b/a\>\"", 
       ",", "\"\<  y = c/a\>\"", ",", "\"\<\>\"", ",", "\"\<Sampling:\>\"", ",", 
       RowBox[{"\"\<  x in [\>\"", "<>", 
        RowBox[{"ToString", "[", "rMin", "]"}], "<>", "\"\<, \>\"", "<>", 
        RowBox[{"ToString", "[", "rMax", "]"}], "<>", "\"\<]\>\""}], ",", 
       RowBox[{"\"\<  y in [\>\"", "<>", 
        RowBox[{"ToString", "[", "sMin", "]"}], "<>", "\"\<, \>\"", "<>", 
        RowBox[{"ToString", "[", "sMax", "]"}], "<>", "\"\<]\>\""}], 
       ",", "\"\<  logarithmic sampling\>\"", ",", 
       RowBox[{"\"\<  nSamples = \>\"", "<>", 
        RowBox[{"ToString", "[", "nSamples", "]"}]}], ",", "\"\<\>\"", 
       ",", "\"\<Spectral data:\>\"", ",", "\"\<  Eigenvalues:\>\"", 
       ",", "\"\<    lambda_nmk = pi^2 (n^2/a^2 + m^2/b^2 + k^2/c^2)\>\"", 
       ",", "\"\<  Truncation:\>\"", ",", "\"\<    N = 2000\>\"", 
       ",", "\"\<\>\"", ",", "\"\<Heat trace fit:\>\"", 
       ",", "\"\<  Fit basis: t^{-3/2}, t^{-1}, t^{-1/2}, t^0\>\"", 
       ",", "\"\<  Time window: t in [f/lambda_N, 500/lambda_N]\>\"", 
       ",", "\"\<  Time grid: logarithmic, nTGrid = 150\>\"", ",", "\"\<\>\"",
        ",", "\"\<Stability search:\>\"", 
       ",", "\"\<  f in [20,150], step 1\>\"", 
       ",", "\"\<  Criterion: minimization of relative A2 error\>\"", 
       ",", "\"\<\>\"", ",", "\"\<Software:\>\"", 
       ",", "\"\<  Wolfram Mathematica\>\"", ",", 
       RowBox[{"\"\<  Version: \>\"", "<>", "$Version"}], ",", 
       RowBox[{"\"\<  Date: \>\"", "<>", 
        RowBox[{"DateString", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Year\>\"", ",", "\"\<-\>\"", ",", "\"\<Month\>\"", 
           ",", "\"\<-\>\"", ",", "\"\<Day\>\""}], "}"}], "]"}]}]}], "}"}], 
     ",", "\"\<Text\>\""}], "]"}], ";"}], "\n"}], "\n"}], "Input",
