          RowBox[{"{", "1", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"exps", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "3"}], "/", "2"}], ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}], ",", "0"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"X", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tGrid", "^", "#"}], "&"}], "/@", "exps"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coef", "=", 
        RowBox[{"LeastSquares", "[", 
         RowBox[{"X", ",", "Z"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
