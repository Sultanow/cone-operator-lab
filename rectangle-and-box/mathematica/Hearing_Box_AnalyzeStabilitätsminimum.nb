       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Weyl", "-", 
          RowBox[{
          "Sch\[ADoubleDot]tzer", " ", "f\[UDoubleDot]r", " ", "3", "D", " ", 
           RowBox[{"Laplacian", ":", 
            RowBox[{
             RowBox[{"N", "~", 
              RowBox[{"(", 
               RowBox[{"V", "/", 
