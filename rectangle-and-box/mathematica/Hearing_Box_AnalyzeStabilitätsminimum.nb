       RowBox[{"b2", "=", 
        RowBox[{"b", "^", "2"}]}], ";", 
       RowBox[{"c2", "=", 
        RowBox[{"c", "^", "2"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"it", "<", 
          RowBox[{"OptionValue", "[", "\"\<MaxIters\>\"", "]"}]}], ",", 
         RowBox[{
          RowBox[{"nMax", "=", 
           RowBox[{"Ceiling", "[", 
            RowBox[{"a", " ", 
             RowBox[{
              RowBox[{"Sqrt", "[", "\[CapitalLambda]", "]"}], "/", "Pi"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"mMax", "=", 
           RowBox[{"Ceiling", "[", 
            RowBox[{"b", " ", 
             RowBox[{
              RowBox[{"Sqrt", "[", "\[CapitalLambda]", "]"}], "/", "Pi"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"kMax", "=", 
