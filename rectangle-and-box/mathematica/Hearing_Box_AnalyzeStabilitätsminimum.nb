      RowBox[{"c_", "?", "NumericQ"}], ",", 
      RowBox[{"N_Integer", "?", "Positive"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<Oversample\>\"", "->", "1.25"}], ",", 
          RowBox[{"(*", 
           RowBox[{
           "Sicherheitsfaktor", " ", "f\[UDoubleDot]r", " ", "Cutoff"}], 
           "*)"}], 
          RowBox[{"\"\<MaxIters\>\"", "->", "8"}]}], "         ", 
