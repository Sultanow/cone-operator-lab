            RowBox[{"c", " ", 
             RowBox[{
              RowBox[{"Sqrt", "[", "\[CapitalLambda]", "]"}], "/", "Pi"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nList", "=", 
           RowBox[{"Range", "[", "nMax", "]"}]}], ";", "\[IndentingNewLine]", 
