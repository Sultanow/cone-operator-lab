           RowBox[{"falls", " ", "zu", " ", "wenig", " ", "Kandidaten"}], ",", 
           RowBox[{"Cutoff", " ", "hochfahren"}]}], "*)"}], "}"}], "]"}]}]}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"V", ",", "\[CapitalLambda]", ",", "overs", ",", 
