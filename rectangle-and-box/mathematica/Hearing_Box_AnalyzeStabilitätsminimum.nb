        RowBox[{"f", "/", "\[Lambda]N"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tMax", "=", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<tMaxFactor\>\"", "]"}], "/", 
         "\[Lambda]N"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tGrid", "=", 
        RowBox[{"Exp", "@", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"Log", "[", "tMin", "]"}], ",", 
           RowBox[{"Log", "[", "tMax", "]"}], ",", 
           RowBox[{"OptionValue", "[", "\"\<nTGrid\>\"", "]"}]}], "]"}]}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"->", 
         RowBox[{"nTGrid", "+", 
          RowBox[{"1", " ", "points"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Z", "=", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
