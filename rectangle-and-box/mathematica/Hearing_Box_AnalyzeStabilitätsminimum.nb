                  RowBox[{"\[Pi]", "^", "2"}]}], ")"}]}], ")"}]}], " ", 
             RowBox[{"\[CapitalLambda]", "^", 
              RowBox[{"(", 
               RowBox[{"3", "/", "2"}], ")"}]}]}]}]}]}], "=", 
         RowBox[{">", 
          RowBox[{
           RowBox[{"\[CapitalLambda]", "~", 
            RowBox[{"(", 
             RowBox[{"6", 
              RowBox[{"\[Pi]", "^", "2"}], " ", 
              RowBox[{"N", "/", "V"}]}], ")"}]}], "^", 
           RowBox[{"(", 
            RowBox[{"2", "/", "3"}], ")"}]}]}]}], "*)"}], 
       RowBox[{"\[CapitalLambda]", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"6", " ", 
            RowBox[{"Pi", "^", "2"}], " ", 
